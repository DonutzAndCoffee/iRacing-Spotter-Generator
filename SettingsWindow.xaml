<Window x:Class="iRacing_Spotter_Generator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Settings" Height="360" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Google Cloud Text-to-Speech API Key" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                   Text="Erstelle einen API-Key in der Google Cloud Console (Text-to-Speech API muss aktiviert sein) und füge ihn hier ein. Der Key wird lokal in %AppData%\iRacingSpotterGenerator\settings.json gespeichert (unverschlüsselt)."/>
        <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="2" Height="26"/>

        <TextBlock Grid.Row="3" Text="Standard-KI-Stimme (Google)" FontWeight="Bold" Margin="0,15,0,5"/>
        <ComboBox x:Name="DefaultVoiceComboBox" Grid.Row="4" Height="26" DisplayMemberPath="Name" SelectedValuePath="Name"/>

        <TextBlock Grid.Row="5" Text="Aufnahmequalität (eigene Aufnahmen)" FontWeight="Bold" Margin="0,15,0,5"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <TextBlock Text="Sample-Rate (Hz):" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="SampleRateComboBox" Width="100" VerticalAlignment="Center"/>
            <TextBlock Text="Bits/Sample:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <ComboBox x:Name="BitsPerSampleComboBox" Width="80" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="7" TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,0"
                   Text="iRacing selbst spielt Spotter-Ansagen mit 5512 Hz / 8 Bit ab (klingt wie Boxenfunk). Höhere Werte klingen sauberer, werden von iRacing aber ohnehin auf dieses Format heruntergerechnet."/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Speichern" Width="90" Margin="0,0,10,0" Click="SaveButton_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Width="90" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
