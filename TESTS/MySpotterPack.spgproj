    {
      "MsgId": "SPCC_NEWUSER2INCPTS",
      "WavFileName": "NEWUSER2INCPTS.WAV",
      "Text": "You\u0027ve just received two incident points. This happens when you hit a wall, spin out, or have light contact with another car.",
