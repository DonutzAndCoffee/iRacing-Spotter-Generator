    <Window x:Class="iRacing_Spotter_Generator.SourceRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{DynamicResource Str_SourceRecordingsWindowTitle}" Height="620" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource Str_ImportSourceRecording}" Padding="10,5" Click="ImportButton_Click"/>
            <Button Content="{DynamicResource Str_Delete}" Padding="10,5" Margin="10,0,0,0" Click="DeleteRecordingButton_Click"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <ListBox x:Name="RecordingsListBox" Grid.Row="1" Height="90" Margin="0,0,0,10"
                 DisplayMemberPath="Name" SelectionChanged="RecordingsListBox_SelectionChanged"/>

        <Border Grid.Row="2" Background="#1E1E1E" Margin="0,0,0,5">
            <Canvas x:Name="WaveformCanvas" ClipToBounds="True" SizeChanged="WaveformCanvas_SizeChanged"
                    MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown" Cursor="Hand">
                <Polyline x:Name="WaveformPolyline" Stroke="#66FF66" StrokeThickness="1"/>
                <Rectangle x:Name="TrimStartOverlay" Fill="#AA000000"/>
                <Rectangle x:Name="TrimEndOverlay" Fill="#AA000000"/>
                <Line x:Name="TrimStartLine" Stroke="Orange" StrokeThickness="2" Y1="0"/>
                <Line x:Name="TrimEndLine" Stroke="Orange" StrokeThickness="2" Y1="0"/>
                <Line x:Name="PlaybackPositionLine" Stroke="White" StrokeThickness="1.5" Y1="0" Visibility="Collapsed"/>
            </Canvas>
        </Border>

        <TextBlock x:Name="TrimDurationTextBlock" Grid.Row="3" Foreground="Gray" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="4">
            <TextBlock Text="{DynamicResource Str_TrimStart}" Margin="0,5,0,0"/>
            <Slider x:Name="TrimStartSlider" Minimum="0" Maximum="1" TickFrequency="0.01"
                    ValueChanged="TrimSlider_ValueChanged" IsEnabled="False"/>

            <TextBlock Text="{DynamicResource Str_TrimEnd}" Margin="0,5,0,0"/>
            <Slider x:Name="TrimEndSlider" Minimum="0" Maximum="1" TickFrequency="0.01"
                    ValueChanged="TrimSlider_ValueChanged" IsEnabled="False"/>

            <TextBlock Text="{DynamicResource Str_UsedRegionsHint}" Foreground="Gray" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <ListBox x:Name="UsedRegionsListBox" Height="80" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="PlayPauseTrimButton" Padding="8,4" Margin="0,0,10,0" Click="PlayPauseTrimButton_Click"/>
            <Button x:Name="UseCutButton" Content="{DynamicResource Str_UseCutSegment}" Padding="8,4" Margin="0,0,10,0"
                    FontWeight="Bold" Click="UseCutButton_Click"/>
            <Button Content="{DynamicResource Str_Close}" Padding="8,4" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
