<Window x:Class="iRacing_Spotter_Generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:iRacing_Spotter_Generator"
        xmlns:models="clr-namespace:iRacing_Spotter_Generator.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="WindowRoot"
        Title="{DynamicResource Str_AppTitle}" Height="700" Width="1250"
        MinHeight="500" MinWidth="900"
        Icon="Assets/AppIcon.png">
    <Window.Resources>
        <ObjectDataProvider x:Key="SourceTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AudioSourceType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Str_Filter}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="FilterTextBox" Width="220" VerticalAlignment="Center"
                     TextChanged="FilterTextBox_TextChanged"/>
            <Button Content="{DynamicResource Str_LoadGoogleVoices}" Margin="20,0,0,0" Padding="8,2" Click="LoadGoogleVoicesButton_Click"/>
            <ToggleButton x:Name="SettingsToggleButton" Content="{DynamicResource Str_Settings}" Margin="10,0,0,0" Padding="8,2"/>
            <Button Content="{DynamicResource Str_AddMessage}" Margin="20,0,0,0" Padding="8,2" FontWeight="Bold" Click="AddMessageButton_Click"/>
            <Button Content="{DynamicResource Str_NewProject}" Margin="20,0,0,0" Padding="8,2" Click="NewProjectButton_Click"/>
            <Button Content="{DynamicResource Str_SaveProject}" Margin="10,0,0,0" Padding="8,2" Click="SaveProjectButton_Click"/>
            <Button Content="{DynamicResource Str_OpenProject}" Margin="10,0,0,0" Padding="8,2" Click="OpenProjectButton_Click"/>
            <Button x:Name="TranslateAllButton" Content="{DynamicResource Str_TranslateAll}" Margin="20,0,0,0" Padding="8,2" Click="TranslateAllButton_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="TranslateAllContextMenu">
                        <MenuItem Header="Deutsch" Tag="de:Deutsch" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="English" Tag="en:English" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Français" Tag="fr:Français" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Español" Tag="es:Español" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Italiano" Tag="it:Italiano" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Nederlands" Tag="nl:Nederlands" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Polski" Tag="pl:Polski" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Português" Tag="pt:Português" Click="TranslateAllLanguageMenuItem_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <TextBlock Text="{DynamicResource Str_Language}" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <ComboBox x:Name="LanguageComboBox" Width="90" VerticalAlignment="Center" SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="Deutsch" Tag="de"/>
                <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
        </StackPanel>

        <!-- Inline settings panel -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10"
                Visibility="{Binding IsChecked, ElementName=SettingsToggleButton, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_GoogleApiKeyHeader}" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,5"
                           Text="{DynamicResource Str_GoogleApiKeyHint}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock>
                        <Hyperlink NavigateUri="https://console.cloud.google.com/apis/credentials" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{DynamicResource Str_LinkCreateApiKey}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" | " Margin="6,0,6,0"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://console.cloud.google.com/apis/library/texttospeech.googleapis.com" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{DynamicResource Str_LinkEnableTts}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" | " Margin="6,0,6,0"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://console.cloud.google.com/apis/library/translate.googleapis.com" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{DynamicResource Str_LinkEnableTranslate}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <PasswordBox x:Name="ApiKeyPasswordBox" Height="26" Width="400" HorizontalAlignment="Left"/>

                <TextBlock Text="{DynamicResource Str_DefaultVoiceHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <ComboBox x:Name="DefaultVoiceComboBox" Height="26" Width="250" HorizontalAlignment="Left"
                          DisplayMemberPath="Name" SelectedValuePath="Name"/>

                <TextBlock Text="{DynamicResource Str_RecordingQualityHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Str_SampleRateLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="SampleRateComboBox" Width="100" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_BitsPerSampleLabel}" VerticalAlignment="Center" Margin="20,0,5,0"/>
                    <ComboBox x:Name="BitsPerSampleComboBox" Width="80" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,10"
                           Text="{DynamicResource Str_RecordingQualityHint}"/>

                <TextBlock Text="{DynamicResource Str_SquelchHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="SquelchEnabledCheckBox" Content="{DynamicResource Str_SquelchAutoAdd}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_SquelchDurationLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="SquelchDurationTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_SquelchVolumeLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="SquelchVolumeTextBox" Width="60" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,10"
                           Text="{DynamicResource Str_SquelchHint}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Str_SaveSettings}" Padding="8,4" Click="SaveSettingsButton_Click" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="GoogleStatusTextBlock" Foreground="Gray" Margin="0,0,0,8"/>

        <!-- Message grid -->
        <DataGrid x:Name="MessagesDataGrid" Grid.Row="3" AutoGenerateColumns="False"
                   CanUserAddRows="False" CanUserDeleteRows="False"
                   ItemsSource="{Binding}" SelectionMode="Extended">
            <DataGrid.Resources>
                <ContextMenu x:Key="RowContextMenu">
                    <MenuItem Header="{DynamicResource Str_Duplicate}" Click="DuplicateMenuItem_Click"/>
                    <MenuItem Header="{DynamicResource Str_Remove}" Click="RemoveMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Str_ProposeTranslationRow}">
                        <MenuItem Header="Deutsch" Tag="de:Deutsch" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="English" Tag="en:English" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Français" Tag="fr:Français" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Español" Tag="es:Español" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Italiano" Tag="it:Italiano" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Nederlands" Tag="nl:Nederlands" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Polski" Tag="pl:Polski" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Português" Tag="pt:Português" Click="RowTranslationLanguageMenuItem_Click"/>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="{DynamicResource Str_ColumnOn}" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                <DataGridTextColumn Header="{DynamicResource Str_ColumnMessageId}" Binding="{Binding MsgId}" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="{DynamicResource Str_ColumnWavFile}" Binding="{Binding WavFileName}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="{DynamicResource Str_ColumnText}" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridComboBoxColumn Header="{DynamicResource Str_ColumnSource}" Width="110"
                                         ItemsSource="{Binding Source={StaticResource SourceTypeValues}}"
                                         SelectedItemBinding="{Binding SourceType, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn Header="{DynamicResource Str_ColumnAiVoice}" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ElementName=WindowRoot, Path=GoogleVoices}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding GoogleVoiceName, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding SourceType, Converter={x:Static local:AudioSourceToBoolConverter.IsGoogleAi}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{DynamicResource Str_ColumnPreview}" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="▶" Padding="4,0" Click="PreviewButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{DynamicResource Str_ColumnRecording}" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource Str_TakesButton}" Padding="4,0" Click="RecordButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource Str_Remove}" Padding="4,0" Click="RemoveMessageButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Output options -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="{DynamicResource Str_PackNameLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="PackNameTextBox" Width="200" VerticalAlignment="Center" Text="MySpotterPack"/>
            <TextBlock Text="{DynamicResource Str_DestinationFolderLabel}" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <TextBox x:Name="DestinationTextBox" Width="380" VerticalAlignment="Center" IsReadOnly="True"/>
            <Button Content="{DynamicResource Str_Browse}" Margin="10,0,0,0" Padding="8,2" Click="BrowseButton_Click"/>
        </StackPanel>

        <!-- Generate -->
        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button x:Name="GenerateButton" Content="{DynamicResource Str_GeneratePack}" Padding="15,5" FontWeight="Bold"
                    Click="GenerateButton_Click"/>
            <CheckBox x:Name="OnlyChangedCheckBox" Content="{DynamicResource Str_OnlyChangedSounds}"
                      VerticalAlignment="Center" Margin="15,0,0,0" IsChecked="True"
                      Checked="OnlyChangedCheckBox_Changed" Unchecked="OnlyChangedCheckBox_Changed"/>
            <ProgressBar x:Name="GenerationProgressBar" Width="400" Height="22" Margin="15,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Pending sounds preview -->
        <Expander x:Name="PendingSoundsExpander" Grid.Row="6" Margin="0,5,0,0"
                  Header="{DynamicResource Str_PendingSoundsHeader}" Expanded="PendingSoundsExpander_Expanded">
            <ListBox x:Name="PendingSoundsListBox" MaxHeight="150" Margin="0,5,0,0"/>
        </Expander>

        <!-- Footer -->
        <DockPanel Grid.Row="7" Margin="0,10,0,0" LastChildFill="False">
            
            <StackPanel DockPanel.Dock="Right" Orientation="Vertical" HorizontalAlignment="Center" Margin="10,0,0,0">
                <Image Source="Assets/AppIcon.png" Width="64" Height="64" HorizontalAlignment="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock x:Name="VersionTextBlock" VerticalAlignment="Center" Foreground="Gray"/>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                        <Hyperlink NavigateUri="https://discord.com/invite/KuSsEYgB3k" RequestNavigate="Hyperlink_RequestNavigate">
                            Discord
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Left" Text=" | Donutz. Proof that sim racing can be delicious." FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
