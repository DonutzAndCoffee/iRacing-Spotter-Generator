<Window x:Class="iRacing_Spotter_Generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:iRacing_Spotter_Generator"
        xmlns:models="clr-namespace:iRacing_Spotter_Generator.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="WindowRoot"
        Title="{DynamicResource Str_AppTitle}" Height="700" Width="1250"
        MinHeight="500" MinWidth="900"
        Icon="Assets/AppIcon.png">
    <Window.Resources>
        <ObjectDataProvider x:Key="SourceTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AudioSourceType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="RowStatusValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:RowStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Background" Value="#FFD0D0D0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource Str_NewProject}" Padding="8,2" Click="NewProjectButton_Click"/>
            <Button Content="{DynamicResource Str_OpenProject}" Margin="10,0,0,0" Padding="8,2" Click="OpenProjectButton_Click"/>
            <Button Content="{DynamicResource Str_SaveProject}" Margin="10,0,0,0" Padding="8,2" Click="SaveProjectButton_Click"/>
            <Button Content="{DynamicResource Str_ImportPack}" Margin="10,0,0,0" Padding="8,2" Click="ImportPackButton_Click"/>

            <Border Style="{StaticResource ToolbarSeparatorStyle}"/>

            <Button Content="{DynamicResource Str_AddMessage}" Padding="8,2" FontWeight="Bold" Click="AddMessageButton_Click"/>
            <Button x:Name="TranslateAllButton" Content="{DynamicResource Str_TranslateAll}" Margin="10,0,0,0" Padding="8,2" Click="TranslateAllButton_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="TranslateAllContextMenu">
                        <MenuItem Header="Deutsch" Tag="de:Deutsch" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="English" Tag="en:English" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Français" Tag="fr:Français" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Español" Tag="es:Español" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Italiano" Tag="it:Italiano" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Nederlands" Tag="nl:Nederlands" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Polski" Tag="pl:Polski" Click="TranslateAllLanguageMenuItem_Click"/>
                        <MenuItem Header="Português" Tag="pt:Português" Click="TranslateAllLanguageMenuItem_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Border Style="{StaticResource ToolbarSeparatorStyle}"/>

            <Button Content="{DynamicResource Str_LoadGoogleVoices}" Padding="8,2" Click="LoadGoogleVoicesButton_Click"/>
            <ToggleButton x:Name="SettingsToggleButton" Margin="10,0,0,0" Padding="8,2"
                          ToolTip="{DynamicResource Str_SettingsToggleTooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Str_Settings}"/>
                    <TextBlock Margin="6,0,0,0" FontSize="9" VerticalAlignment="Center"
                               Text="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={x:Static local:BoolToArrowConverter.Instance}}"/>
                </StackPanel>
            </ToggleButton>

            <Border Style="{StaticResource ToolbarSeparatorStyle}"/>

            <TextBlock Text="{DynamicResource Str_Language}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="LanguageComboBox" Width="90" VerticalAlignment="Center" SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="Deutsch" Tag="de"/>
                <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>

            <Border Style="{StaticResource ToolbarSeparatorStyle}"/>

            <Button Content="{DynamicResource Str_License}" Padding="8,2" Click="LicenseButton_Click"/>
            <Button Content="{DynamicResource Str_Help}" Padding="8,2" Margin="5,0,0,0" Click="HelpButton_Click"/>
        </WrapPanel>

        <!-- Inline settings panel -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10"
                Visibility="{Binding IsChecked, ElementName=SettingsToggleButton, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_GoogleApiKeyHeader}" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,5"
                           Text="{DynamicResource Str_GoogleApiKeyHint}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock>
                        <Hyperlink NavigateUri="https://console.cloud.google.com/apis/credentials" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{DynamicResource Str_LinkCreateApiKey}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" | " Margin="6,0,6,0"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://console.cloud.google.com/apis/library/texttospeech.googleapis.com" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{DynamicResource Str_LinkEnableTts}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" | " Margin="6,0,6,0"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://console.cloud.google.com/apis/library/translate.googleapis.com" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{DynamicResource Str_LinkEnableTranslate}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <PasswordBox x:Name="ApiKeyPasswordBox" Height="26" Width="400" HorizontalAlignment="Left"/>

                <TextBlock Text="{DynamicResource Str_DefaultVoiceHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <ComboBox x:Name="DefaultVoiceComboBox" Height="26" Width="250" HorizontalAlignment="Left"
                          DisplayMemberPath="Name" SelectedValuePath="Name"/>

                <TextBlock Text="{DynamicResource Str_RecordingQualityHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Str_SampleRateLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="SampleRateComboBox" Width="100" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_BitsPerSampleLabel}" VerticalAlignment="Center" Margin="20,0,5,0"/>
                    <ComboBox x:Name="BitsPerSampleComboBox" Width="80" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,10"
                           Text="{DynamicResource Str_RecordingQualityHint}"/>

                <TextBlock Text="{DynamicResource Str_SquelchHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="SquelchEnabledCheckBox" Content="{DynamicResource Str_SquelchAutoAdd}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_SquelchDurationLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="SquelchDurationTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_SquelchVolumeLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="SquelchVolumeTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="{DynamicResource Str_Test}" Padding="8,2" Click="SquelchTestButton_Click"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,10"
                           Text="{DynamicResource Str_SquelchHint}"/>

                <TextBlock Text="{DynamicResource Str_PttHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="PttEnabledCheckBox" Content="{DynamicResource Str_PttAutoAdd}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_PttDurationLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="PttDurationTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_PttVolumeLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="PttVolumeTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="{DynamicResource Str_Test}" Padding="8,2" Click="PttTestButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="{DynamicResource Str_PttEndFrequencyLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="PttEndFrequencyTextBox" Width="60" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="{DynamicResource Str_PttEndFileLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="PttEndFileTextBox" Width="250" VerticalAlignment="Center" IsReadOnly="True"/>
                    <Button Content="{DynamicResource Str_Browse}" Margin="5,0,5,0" Padding="8,2" Click="PttEndFileBrowseButton_Click"/>
                    <Button Content="{DynamicResource Str_Clear}" Padding="8,2" Click="PttEndFileClearButton_Click"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,10"
                           Text="{DynamicResource Str_PttHint}"/>

                <TextBlock Text="{DynamicResource Str_RadioEffectHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="RadioEffectEnabledCheckBox" Content="{DynamicResource Str_RadioEffectAutoAdd}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_RadioEffectLowCutLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="RadioEffectLowCutTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_RadioEffectHighCutLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="RadioEffectHighCutTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Str_RadioEffectDistortionLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="RadioEffectDistortionTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="{DynamicResource Str_Test}" Padding="8,2" Click="RadioEffectTestButton_Click"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,10"
                           Text="{DynamicResource Str_RadioEffectHint}"/>

                <TextBlock Text="{DynamicResource Str_OutputVolumeHeader}" FontWeight="Bold" Margin="0,15,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Str_OutputVolumeLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="OutputVolumeTextBox" Width="60" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="{DynamicResource Str_Test}" Padding="8,2" Click="OutputVolumeTestButton_Click"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,10"
                           Text="{DynamicResource Str_OutputVolumeHint}"/>

                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,5"
                           Text="{DynamicResource Str_TestHint}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Str_TestRecordingLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TestRecordingTextBox" Width="220" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button x:Name="TestRecordButton" Content="{DynamicResource Str_StartRecording}" Padding="8,2" Margin="0,0,5,0" Click="TestRecordButton_Click"/>
                    <Button Content="{DynamicResource Str_Browse}" Padding="8,2" Margin="0,0,5,0" Click="TestRecordingBrowseButton_Click"/>
                    <Button Content="{DynamicResource Str_Clear}" Padding="8,2" Click="TestRecordingClearButton_Click"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                           Text="{DynamicResource Str_TestRecordingHint}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Str_SaveSettings}" Padding="8,4" Click="SaveSettingsButton_Click" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource Str_TestAll}" Padding="8,4" Click="TestAllButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="GoogleStatusTextBlock" Foreground="Gray" Margin="0,0,0,8"/>

        <!-- Message grid -->
        <!-- Bulk row toggles -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="{DynamicResource Str_BulkToggleLabel}" VerticalAlignment="Center" Margin="0,0,10,2" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,15,2">
                <TextBlock Text="{DynamicResource Str_ColumnStartTooltip}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource Str_CheckAll}" Tag="AddSquelchStart:True" Click="BulkToggleColumnButton_Click" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="{DynamicResource Str_UncheckAll}" Tag="AddSquelchStart:False" Click="BulkToggleColumnButton_Click" Padding="6,2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,15,2">
                <TextBlock Text="{DynamicResource Str_ColumnEndTooltip}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource Str_CheckAll}" Tag="AddSquelchEnd:True" Click="BulkToggleColumnButton_Click" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="{DynamicResource Str_UncheckAll}" Tag="AddSquelchEnd:False" Click="BulkToggleColumnButton_Click" Padding="6,2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,15,2">
                <TextBlock Text="{DynamicResource Str_ColumnRadioEffectTooltip}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource Str_CheckAll}" Tag="AddRadioEffect:True" Click="BulkToggleColumnButton_Click" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="{DynamicResource Str_UncheckAll}" Tag="AddRadioEffect:False" Click="BulkToggleColumnButton_Click" Padding="6,2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="{DynamicResource Str_ColumnPttEndTooltip}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Content="{DynamicResource Str_CheckAll}" Tag="AddPttEnd:True" Click="BulkToggleColumnButton_Click" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="{DynamicResource Str_UncheckAll}" Tag="AddPttEnd:False" Click="BulkToggleColumnButton_Click" Padding="6,2"/>
            </StackPanel>
        </WrapPanel>

        <DataGrid x:Name="MessagesDataGrid" Grid.Row="4" AutoGenerateColumns="False"
                   CanUserAddRows="False" CanUserDeleteRows="False"
                   ItemsSource="{Binding}" SelectionMode="Extended"
                   PreviewMouseLeftButtonDown="MessagesDataGrid_PreviewMouseLeftButtonDown">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Resources>
                <ContextMenu x:Key="RowContextMenu">
                    <MenuItem Header="{DynamicResource Str_Duplicate}" Click="DuplicateMenuItem_Click"/>
                    <MenuItem Header="{DynamicResource Str_Remove}" Click="RemoveMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Str_ProposeTranslationRow}">
                        <MenuItem Header="Deutsch" Tag="de:Deutsch" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="English" Tag="en:English" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Français" Tag="fr:Français" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Español" Tag="es:Español" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Italiano" Tag="it:Italiano" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Nederlands" Tag="nl:Nederlands" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Polski" Tag="pl:Polski" Click="RowTranslationLanguageMenuItem_Click"/>
                        <MenuItem Header="Português" Tag="pt:Português" Click="RowTranslationLanguageMenuItem_Click"/>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="55">
                    <DataGridCheckBoxColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnOn}" ToolTip="{DynamicResource Str_ColumnOnTooltip}"/>
                            <ComboBox x:Name="EnabledFilterComboBox" Margin="0,2,0,0" FontWeight="Normal"
                                      SelectionChanged="EnabledFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str_FilterAll}" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Str_ColumnOn}" Tag="On"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterOff}" Tag="Off"/>
                            </ComboBox>
                        </StackPanel>
                    </DataGridCheckBoxColumn.Header>
                    <DataGridCheckBoxColumn.Binding>
                        <Binding Path="Enabled" UpdateSourceTrigger="PropertyChanged"/>
                    </DataGridCheckBoxColumn.Binding>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn IsReadOnly="True" Width="200">
                    <DataGridTextColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnMessageId}" ToolTip="{DynamicResource Str_ColumnMessageIdTooltip}"/>
                            <TextBox x:Name="FilterTextBox" Margin="0,2,0,0" FontWeight="Normal"
                                     ToolTip="{DynamicResource Str_Filter}"
                                     TextChanged="FilterTextBox_TextChanged"/>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.Binding>
                        <Binding Path="MsgId"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn IsReadOnly="True" Width="150">
                    <DataGridTextColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnWavFile}" ToolTip="{DynamicResource Str_ColumnWavFileTooltip}"/>
                            <TextBox x:Name="WavFileFilterTextBox" Margin="0,2,0,0" FontWeight="Normal"
                                     ToolTip="{DynamicResource Str_Filter}"
                                     TextChanged="WavFileFilterTextBox_TextChanged"/>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.Binding>
                        <Binding Path="WavFileName"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn IsReadOnly="True" Width="100">
                    <DataGridCheckBoxColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnExported}" ToolTip="{DynamicResource Str_ColumnExportedTooltip}"/>
                            <ComboBox x:Name="ExportedFilterComboBox" Margin="0,2,0,0" FontWeight="Normal"
                                      SelectionChanged="ExportedFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str_FilterAll}" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterYes}" Tag="Yes"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterNo}" Tag="No"/>
                            </ComboBox>
                        </StackPanel>
                    </DataGridCheckBoxColumn.Header>
                    <DataGridCheckBoxColumn.Binding>
                        <Binding Path="IsExported"/>
                    </DataGridCheckBoxColumn.Binding>
                </DataGridCheckBoxColumn>
                <DataGridComboBoxColumn Width="130"
                                         ItemsSource="{Binding Source={StaticResource RowStatusValues}}"
                                         SelectedItemBinding="{Binding Status, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnStatus}" ToolTip="{DynamicResource Str_ColumnStatusTooltip}"/>
                            <ComboBox x:Name="StatusFilterComboBox" Margin="0,2,0,0" FontWeight="Normal"
                                      SelectionChanged="StatusFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str_FilterAll}" Tag="{x:Null}" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                    </DataGridComboBoxColumn.Header>
                </DataGridComboBoxColumn>
                <DataGridCheckBoxColumn Width="90">
                    <DataGridCheckBoxColumn.Header>
                        <StackPanel>
                            <TextBlock Text="√Start" ToolTip="{DynamicResource Str_ColumnStartTooltip}"/>
                            <ComboBox x:Name="StartFilterComboBox" Margin="0,2,0,0" FontWeight="Normal"
                                      SelectionChanged="StartFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str_FilterAll}" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterYes}" Tag="Yes"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterNo}" Tag="No"/>
                            </ComboBox>
                        </StackPanel>
                    </DataGridCheckBoxColumn.Header>
                    <DataGridCheckBoxColumn.Binding>
                        <Binding Path="AddSquelchStart" UpdateSourceTrigger="PropertyChanged"/>
                    </DataGridCheckBoxColumn.Binding>
                </DataGridCheckBoxColumn>
                <DataGridCheckBoxColumn Width="90">
                    <DataGridCheckBoxColumn.Header>
                        <StackPanel>
                            <TextBlock Text="√End" ToolTip="{DynamicResource Str_ColumnEndTooltip}"/>
                            <ComboBox x:Name="EndFilterComboBox" Margin="0,2,0,0" FontWeight="Normal"
                                      SelectionChanged="EndFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str_FilterAll}" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterYes}" Tag="Yes"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterNo}" Tag="No"/>
                            </ComboBox>
                        </StackPanel>
                    </DataGridCheckBoxColumn.Header>
                    <DataGridCheckBoxColumn.Binding>
                        <Binding Path="AddSquelchEnd" UpdateSourceTrigger="PropertyChanged"/>
                    </DataGridCheckBoxColumn.Binding>
                </DataGridCheckBoxColumn>
                <DataGridCheckBoxColumn Width="110">
                    <DataGridCheckBoxColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnRadioEffect}" ToolTip="{DynamicResource Str_ColumnRadioEffectTooltip}"/>
                            <ComboBox x:Name="RadioEffectFilterComboBox" Margin="0,2,0,0" FontWeight="Normal"
                                      SelectionChanged="RadioEffectFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str_FilterAll}" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterYes}" Tag="Yes"/>
                                <ComboBoxItem Content="{DynamicResource Str_FilterNo}" Tag="No"/>
                            </ComboBox>
                        </StackPanel>
                    </DataGridCheckBoxColumn.Header>
                    <DataGridCheckBoxColumn.Binding>
                        <Binding Path="AddRadioEffect" UpdateSourceTrigger="PropertyChanged"/>
                    </DataGridCheckBoxColumn.Binding>
                </DataGridCheckBoxColumn>
                <DataGridCheckBoxColumn Width="90">
                    <DataGridCheckBoxColumn.Header>
                        <TextBlock Text="{DynamicResource Str_ColumnPttEnd}" ToolTip="{DynamicResource Str_ColumnPttEndTooltip}"/>
                    </DataGridCheckBoxColumn.Header>
                    <DataGridCheckBoxColumn.Binding>
                        <Binding Path="AddPttEnd" UpdateSourceTrigger="PropertyChanged"/>
                    </DataGridCheckBoxColumn.Binding>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Width="*">
                    <DataGridTextColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnText}" ToolTip="{DynamicResource Str_ColumnTextTooltip}"/>
                            <TextBox x:Name="TextFilterTextBox" Margin="0,2,0,0" FontWeight="Normal"
                                     ToolTip="{DynamicResource Str_Filter}"
                                     TextChanged="TextFilterTextBox_TextChanged"/>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.Binding>
                        <Binding Path="Text" UpdateSourceTrigger="PropertyChanged"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridComboBoxColumn Width="130"
                                         ItemsSource="{Binding Source={StaticResource SourceTypeValues}}"
                                         SelectedItemBinding="{Binding SourceType, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnSource}" ToolTip="{DynamicResource Str_ColumnSourceTooltip}"/>
                            <ComboBox x:Name="SourceFilterComboBox" Margin="0,2,0,0" FontWeight="Normal"
                                      SelectionChanged="SourceFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str_FilterAll}" Tag="{x:Null}" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                    </DataGridComboBoxColumn.Header>
                </DataGridComboBoxColumn>
                <DataGridTemplateColumn Width="180">
                    <DataGridTemplateColumn.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_ColumnAiVoice}" ToolTip="{DynamicResource Str_ColumnAiVoiceTooltip}"/>
                            <TextBox x:Name="AiVoiceFilterTextBox" Margin="0,2,0,0" FontWeight="Normal"
                                     ToolTip="{DynamicResource Str_Filter}"
                                     TextChanged="AiVoiceFilterTextBox_TextChanged"/>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ElementName=WindowRoot, Path=GoogleVoices}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding GoogleVoiceName, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding SourceType, Converter={x:Static local:AudioSourceToBoolConverter.IsGoogleAi}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource Str_ColumnPreview}" ToolTip="{DynamicResource Str_ColumnPreviewTooltip}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="▶" Padding="4,0" Click="PreviewButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource Str_ColumnRecording}" ToolTip="{DynamicResource Str_ColumnRecordingTooltip}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource Str_TakesButton}" Padding="4,0" Click="RecordButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="" ToolTip="{DynamicResource Str_ColumnRemoveTooltip}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource Str_Remove}" Padding="4,0" Click="RemoveMessageButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Output options -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="{DynamicResource Str_PackNameLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="PackNameTextBox" Width="200" VerticalAlignment="Center" Text="MySpotterPack"/>
            <TextBlock Text="{DynamicResource Str_DestinationFolderLabel}" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <TextBox x:Name="DestinationTextBox" Width="380" VerticalAlignment="Center" IsReadOnly="True"/>
            <Button Content="{DynamicResource Str_Browse}" Margin="10,0,0,0" Padding="8,2" Click="BrowseButton_Click"/>
        </StackPanel>

        <!-- Generate -->
        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button x:Name="GenerateButton" Content="{DynamicResource Str_GeneratePack}" Padding="15,5" FontWeight="Bold"
                    Click="GenerateButton_Click"/>
            <CheckBox x:Name="OnlyChangedCheckBox" Content="{DynamicResource Str_OnlyChangedSounds}"
                      VerticalAlignment="Center" Margin="15,0,0,0" IsChecked="True"
                      Checked="OnlyChangedCheckBox_Changed" Unchecked="OnlyChangedCheckBox_Changed"/>
            <ProgressBar x:Name="GenerationProgressBar" Width="400" Height="22" Margin="15,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Pending sounds preview -->
        <Expander x:Name="PendingSoundsExpander" Grid.Row="7" Margin="0,5,0,0"
                  Header="{DynamicResource Str_PendingSoundsHeader}" Expanded="PendingSoundsExpander_Expanded">
            <ListBox x:Name="PendingSoundsListBox" MaxHeight="150" Margin="0,5,0,0"/>
        </Expander>

        <!-- Footer -->
        <DockPanel Grid.Row="8" Margin="0,10,0,0" LastChildFill="False">
            
            <StackPanel DockPanel.Dock="Right" Orientation="Vertical" HorizontalAlignment="Center" Margin="10,0,0,0">
                <Image Source="Assets/AppIcon.png" Width="64" Height="64" HorizontalAlignment="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock x:Name="VersionTextBlock" VerticalAlignment="Center" Foreground="Gray"/>
                    <TextBlock x:Name="UpdateAvailableTextBlock" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="OrangeRed" FontWeight="Bold" Visibility="Collapsed">
                        <Hyperlink x:Name="UpdateAvailableHyperlink" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run x:Name="UpdateAvailableRun"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                        <Hyperlink NavigateUri="https://github.com/DonutzAndCoffee/iRacing-Spotter-Generator" RequestNavigate="Hyperlink_RequestNavigate">
                            GitHub
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                        <Hyperlink NavigateUri="https://discord.com/invite/KuSsEYgB3k" RequestNavigate="Hyperlink_RequestNavigate">
                            Discord
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Left" Text=" | Donutz. Proof that sim racing can be delicious." FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
