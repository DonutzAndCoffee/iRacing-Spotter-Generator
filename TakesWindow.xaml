    <Window x:Class="iRacing_Spotter_Generator.TakesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Aufnahme" Height="680" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock" Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="RecordButton" Content="● Aufnahme starten" Padding="10,5" Click="RecordButton_Click"/>
            <TextBlock x:Name="RecordingStatusTextBlock" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Red"/>
        </StackPanel>

        <TextBlock x:Name="QualityTextBlock" Grid.Row="2" Foreground="Gray" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Aufgenommene Takes:" Margin="0,0,0,5"/>

        <ListBox x:Name="TakesListBox" Grid.Row="4" Margin="0,0,0,10"
                 SelectionChanged="TakesListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Wertung:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <ComboBox x:Name="RatingComboBox" Width="60" VerticalAlignment="Center"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding RatingText, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10"/>
                        </ComboBox>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="5" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Schnitt-Tool (Start/Ende festlegen)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="TrimDurationTextBlock" Foreground="Gray" Margin="0,0,0,5"/>

                <Border Background="#1E1E1E" Height="100" Margin="0,0,0,5">
                    <Canvas x:Name="WaveformCanvas" ClipToBounds="True" SizeChanged="WaveformCanvas_SizeChanged"
                            MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown" Cursor="Hand">
                        <Polyline x:Name="WaveformPolyline" Stroke="#66FF66" StrokeThickness="1"/>
                        <Rectangle x:Name="TrimStartOverlay" Fill="#AA000000"/>
                        <Rectangle x:Name="TrimEndOverlay" Fill="#AA000000"/>
                        <Line x:Name="TrimStartLine" Stroke="Orange" StrokeThickness="2" Y1="0"/>
                        <Line x:Name="TrimEndLine" Stroke="Orange" StrokeThickness="2" Y1="0"/>
                        <Line x:Name="PlaybackPositionLine" Stroke="White" StrokeThickness="1.5" Y1="0" Visibility="Collapsed"/>
                    </Canvas>
                </Border>

                <TextBlock Text="Start (Sek.):" Margin="0,5,0,0"/>
                <Slider x:Name="TrimStartSlider" Minimum="0" Maximum="1" TickFrequency="0.01"
                        ValueChanged="TrimSlider_ValueChanged" IsEnabled="False"/>

                <TextBlock Text="Ende (Sek.):" Margin="0,5,0,0"/>
                <Slider x:Name="TrimEndSlider" Minimum="0" Maximum="1" TickFrequency="0.01"
                        ValueChanged="TrimSlider_ValueChanged" IsEnabled="False"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="PlayPauseTrimButton" Content="▶ Ausschnitt abspielen" Padding="8,4" Margin="0,0,10,0"
                            Click="PlayPauseTrimButton_Click"/>
                    <Button Content="Zuschneiden &amp; als neuen Take speichern" Padding="8,4" FontWeight="Bold"
                            Click="ApplyTrimButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="▶ Abspielen" Padding="8,4" Margin="0,0,10,0" Click="PlayButton_Click"/>
            <Button Content="Löschen" Padding="8,4" Margin="0,0,10,0" Click="DeleteButton_Click"/>
            <Button Content="Diesen Take verwenden" Padding="8,4" Margin="0,0,10,0" Click="UseTakeButton_Click" FontWeight="Bold"/>
            <Button Content="Abbrechen" Padding="8,4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
