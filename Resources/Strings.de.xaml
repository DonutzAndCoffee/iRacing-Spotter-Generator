    <sys:String x:Key="Str_CannotRemoveTitle">Nachricht kann nicht entfernt werden</sys:String>
    <sys:String x:Key="Str_NoTakeRecorded">Für diese Zeile wurde noch kein Take aufgenommen.</sys:String>
    <sys:String x:Key="Str_PreviewTitle">Vorschau</sys:String>
    <sys:String x:Key="Str_NoGoogleApiKeyForPreview">Bitte zuerst einen Google API-Key unter 'Einstellungen' hinterlegen.</sys:String>
    <sys:String x:Key="Str_NoGoogleVoiceForPreview">Bitte zuerst eine Google-KI-Stimme für diese Zeile auswählen oder eine Standard-Stimme in den Einstellungen festlegen.</sys:String>
    <sys:String x:Key="Str_GooglePreviewFailed">Google-Vorschau fehlgeschlagen:</sys:String>
    <sys:String x:Key="Str_ProjectSaved">Projekt gespeichert:</sys:String>
    <sys:String x:Key="Str_ProjectSaveFailed">Projekt konnte nicht gespeichert werden:</sys:String>
    <sys:String x:Key="Str_SaveProjectTitle">Projekt speichern</sys:String>
    <sys:String x:Key="Str_ProjectLoaded">Projekt geladen:</sys:String>
    <sys:String x:Key="Str_ProjectLoadFailed">Projekt konnte nicht geladen werden:</sys:String>
    <sys:String x:Key="Str_OpenProjectTitle">Projekt öffnen</sys:String>
    <sys:String x:Key="Str_ChooseDestinationFirst">Bitte zuerst einen Zielordner auswählen.</sys:String>
    <sys:String x:Key="Str_Generating">Generiere...</sys:String>
    <sys:String x:Key="Str_Done">Fertig!</sys:String>
    <sys:String x:Key="Str_PackGeneratedSuccess">Spotter-Pack erfolgreich erstellt unter:</sys:String>
    <sys:String x:Key="Str_Failed">Fehlgeschlagen.</sys:String>
    <sys:String x:Key="Str_NoGoogleApiKeyForTranslation">Bitte zuerst einen Google API-Key unter 'Einstellungen' hinterlegen (Cloud Translation API muss aktiviert sein).</sys:String>
    <sys:String x:Key="Str_TranslationFailed">Übersetzung fehlgeschlagen:</sys:String>
    <sys:String x:Key="Str_PackGenerationFailed">Pack-Erstellung fehlgeschlagen:</sys:String>

