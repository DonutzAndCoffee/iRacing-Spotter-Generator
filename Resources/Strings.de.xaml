    <sys:String x:Key="Str_GoogleApiKeyHint">Erstelle einen API-Key in der Google Cloud Console (Text-to-Speech API muss aktiviert sein). Der Key wird lokal in %AppData%\iRacingSpotterGenerator\settings.json gespeichert (unverschlüsselt).</sys:String>
    <sys:String x:Key="Str_LinkCreateApiKey">API-Key erstellen</sys:String>
    <sys:String x:Key="Str_LinkEnableTts">Text-to-Speech API aktivieren</sys:String>
    <sys:String x:Key="Str_LinkEnableTranslate">Translation API aktivieren</sys:String>
    <sys:String x:Key="Str_DefaultVoiceHeader">Standard-KI-Stimme (Google)</sys:String>
    <sys:String x:Key="Str_RecordingQualityHeader">Aufnahmequalität (eigene Aufnahmen)</sys:String>
