<Window x:Class="iRacing_Spotter_Generator.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{DynamicResource Str_LicenseTitle}" Height="480" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_LicenseTitle}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource Str_LicenseIntro}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Str_LicenseDisclaimer}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Str_LicenseNoWarranty}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Str_LicenseUsage}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Str_LicenseGeneratedContent}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="OK" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                Width="80" Padding="8,4" Margin="0,10,0,0" Click="OkButton_Click"/>
    </Grid>
</Window>
